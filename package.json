{
  "name": "@luisfadini/class-validator-jsonschema",
  "version": "5.1.0",
  "description": "Convert class-validator-decorated classes into JSON schema",
  "keywords": [
    "class-validator",
    "jsonschema",
    "openapi",
    "swagger"
  ],
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "repository": "git@github.com:luisfadini/class-validator-jsonschema.git",
  "author": "Luís Otávio <84397555+LuisFadini@users.noreply.github.com>",
  "license": "MIT",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('build', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.release.json",
    "prepare": "pnpm build",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "openapi3-ts": "^4.6.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/validator": "^13.7.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1"
  },
  "packageManager": "pnpm@11.17.0"
}
